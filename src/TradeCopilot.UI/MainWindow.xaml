<Window x:Class="TradeCopilot.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:TradeCopilot.UI"
        xmlns:tb="http://www.hardcodet.net/taskbar"
        Title="TradeCopilot" Width="420" Height="600"
        MinWidth="360" MinHeight="400"
        WindowStyle="None" ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="True" Topmost="True"
        AllowsTransparency="False"
        Background="#1A1A1A" Foreground="#E0E0E0"
        FontFamily="Segoe UI"
        WindowStartupLocation="Manual">
    <Window.Resources>
        <local:BooleanToBrushConverter x:Key="CaptureBrush" ActiveBrush="#4CAF50" InactiveBrush="#F44336" />
        <local:BooleanToVisibilityConverter x:Key="VisibleWhenTrue" />
        <local:BooleanToVisibilityConverter x:Key="VisibleWhenFalse" Invert="True" />
        <!-- Tray icon: left-click toggles the overlay (TrayLeftMouseUp in code-behind),
             right-click opens this menu. DataContext is assigned in MainWindow's ctor. -->
        <tb:TaskbarIcon x:Key="TrayIcon"
                        IconSource="/Assets/tray.ico"
                        ToolTipText="TradeCopilot"
                        MenuActivation="RightClick">
            <tb:TaskbarIcon.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Show overlay" Command="{Binding ShowOverlayCommand}"/>
                    <MenuItem Header="Pause capture" Command="{Binding PauseCaptureCommand}"/>
                    <MenuItem Header="Resume capture" Command="{Binding ResumeCaptureCommand}"/>
                    <Separator/>
                    <MenuItem Header="Settings..." Command="{Binding OpenSettingsCommand}"/>
                    <MenuItem Header="View audit log" Command="{Binding OpenAuditLogCommand}"/>
                    <Separator/>
                    <MenuItem Header="Quit" Command="{Binding QuitCommand}"/>
                </ContextMenu>
            </tb:TaskbarIcon.ContextMenu>
        </tb:TaskbarIcon>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Background="#232323" MouseLeftButtonDown="Header_MouseLeftButtonDown">
            <Grid Margin="12,0,8,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="TradeCopilot" FontWeight="Bold" FontSize="14" VerticalAlignment="Center" Foreground="#E0E0E0" />
                <Ellipse Grid.Column="1" Width="10" Height="10" Margin="10,0,0,0" VerticalAlignment="Center"
                         Fill="{Binding CaptureActive, Converter={StaticResource CaptureBrush}}" />
                <Button Grid.Column="3" Content="Pause" Padding="10,4" Margin="0,0,4,0" VerticalAlignment="Center"
                        Command="{Binding PauseCaptureCommand}"
                        Visibility="{Binding CaptureActive, Converter={StaticResource VisibleWhenTrue}}" />
                <Button Grid.Column="3" Content="Resume" Padding="10,4" Margin="0,0,4,0" VerticalAlignment="Center"
                        Command="{Binding ResumeCaptureCommand}"
                        Visibility="{Binding CaptureActive, Converter={StaticResource VisibleWhenFalse}}" />
                <Button Grid.Column="4" Content="\u2014" Width="32" Margin="0,0,4,0" VerticalAlignment="Center" ToolTip="Minimize to taskbar" Click="MinimizeButton_Click" />
                <Button Grid.Column="5" Content="\u00D7" Width="32" VerticalAlignment="Center" ToolTip="Hide to tray" Click="CloseButton_Click" />
            </Grid>
        </Border>
        <!-- Degraded-mode banner: required AI models are missing (rules + cache only). -->
        <Border Grid.Row="1" Background="#4A3200" Padding="12,6"
                Visibility="{Binding DegradedMode, Converter={StaticResource VisibleWhenTrue}}">
            <TextBlock Text="{Binding DegradedBannerText}" TextWrapping="Wrap"
                       Foreground="#FFB74D" FontSize="11" />
        </Border>
        <ScrollViewer Grid.Row="2" x:Name="MessageScroll" VerticalScrollBarVisibility="Auto" Padding="12">
            <ItemsControl ItemsSource="{Binding Messages}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border CornerRadius="8" Padding="10" Margin="0,0,0,8" MaxWidth="360" HorizontalAlignment="Left" Background="#2A2A2A">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Role}" Value="User">
                                            <Setter Property="HorizontalAlignment" Value="Right" />
                                            <Setter Property="Background" Value="#2A4A6A" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Role}" Value="System">
                                            <Setter Property="HorizontalAlignment" Value="Center" />
                                            <Setter Property="Background" Value="Transparent" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel>
                                <TextBlock Text="{Binding Text}" TextWrapping="Wrap" Foreground="#E0E0E0" />
                                <TextBlock Margin="0,4,0,0" FontSize="10" Foreground="#888888">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Role}" Value="User">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Role}" Value="System">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                    <Run Text="{Binding Source, Mode=OneWay}" /><Run Text=" | " /><Run Text="{Binding ElapsedMs, Mode=OneWay}" /><Run Text="ms" />
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
        <Border Grid.Row="3" Background="#232323" Padding="12,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding StatusText}" FontSize="11" Foreground="#888888" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{Binding VersionText}" FontSize="11" Foreground="#888888" VerticalAlignment="Center" />
            </Grid>
        </Border>
        <Border Grid.Row="4" Background="#1A1A1A" Padding="12,8" BorderBrush="#3A3A3A" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" x:Name="InputBox" Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}"
                         Background="#2A2A2A" Foreground="#E0E0E0" BorderBrush="#3A3A3A" Padding="8"
                         VerticalContentAlignment="Center">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding SendCommand}" />
                    </TextBox.InputBindings>
                </TextBox>
                <Button Grid.Column="1" Content="{Binding MicButtonText}" Width="72" Margin="8,0,0,0"
                        IsEnabled="{Binding MicAvailable}"
                        ToolTip="Push-to-talk (Ctrl+Alt+Space): click to start/stop recording."
                        Command="{Binding ToggleRecordingCommand}" />
                <Button Grid.Column="2" Content="Send" Width="60" Margin="8,0,0,0" Background="#4A9EFF" Foreground="White"
                        Command="{Binding SendCommand}" />
            </Grid>
        </Border>
    </Grid>
</Window>
