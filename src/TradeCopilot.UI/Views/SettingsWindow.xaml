<Window x:Class="TradeCopilot.UI.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TradeCopilot Settings" Width="500" Height="450"
        MinWidth="440" MinHeight="380"
        WindowStartupLocation="CenterScreen"
        Background="#1A1A1A" Foreground="#E0E0E0"
        FontFamily="Segoe UI" ResizeMode="CanResize">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TabControl Background="#232323" Foreground="#E0E0E0" BorderBrush="#3A3A3A">

            <!-- Tab 1: Capture. Numeric inputs now; drag-picker is TODO for v1.1. -->
            <TabItem Header="Capture">
                <StackPanel Margin="12" Background="#232323">
                    <TextBlock Text="Capture region (pixels). 0/0/0/0 = full screen." Foreground="#B0B0B0" TextWrapping="Wrap" />
                    <!-- TODO(v1.1): full-screen transparent drag picker; numeric fallback for v1. -->
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" /><ColumnDefinition Width="60" />
                            <ColumnDefinition Width="Auto" /><ColumnDefinition Width="60" />
                            <ColumnDefinition Width="Auto" /><ColumnDefinition Width="60" />
                            <ColumnDefinition Width="Auto" /><ColumnDefinition Width="60" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="X " VerticalAlignment="Center" />
                        <TextBox Grid.Column="1" x:Name="RegionXBox" Background="#2A2A2A" Foreground="#E0E0E0" BorderBrush="#3A3A3A" Padding="4" Margin="0,0,8,0" />
                        <TextBlock Grid.Column="2" Text="Y " VerticalAlignment="Center" />
                        <TextBox Grid.Column="3" x:Name="RegionYBox" Background="#2A2A2A" Foreground="#E0E0E0" BorderBrush="#3A3A3A" Padding="4" Margin="0,0,8,0" />
                        <TextBlock Grid.Column="4" Text="W " VerticalAlignment="Center" />
                        <TextBox Grid.Column="5" x:Name="RegionWBox" Background="#2A2A2A" Foreground="#E0E0E0" BorderBrush="#3A3A3A" Padding="4" Margin="0,0,8,0" />
                        <TextBlock Grid.Column="6" Text="H " VerticalAlignment="Center" />
                        <TextBox Grid.Column="7" x:Name="RegionHBox" Background="#2A2A2A" Foreground="#E0E0E0" BorderBrush="#3A3A3A" Padding="4" />
                    </Grid>
                    <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                        <TextBlock Text="Frame rate: " VerticalAlignment="Center" />
                        <Slider x:Name="FpsSlider" Width="180" Minimum="1" Maximum="10" Value="2" ValueChanged="FpsSlider_ValueChanged"
                                TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center" />
                        <TextBlock x:Name="FpsLabel" Text="2 FPS" Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Margin="0,16,0,0" Foreground="#888888" FontSize="11" TextWrapping="Wrap"
                               Text="Note: region and FPS are stored here for v1.1 service sync; the service reads its own configuration in v1." />
                </StackPanel>
            </TabItem>

            <!-- Tab 2: Language (reserved in v1). -->
            <TabItem Header="Language">
                <StackPanel Margin="12" Background="#232323">
                    <TextBlock Text="Display language" FontWeight="Bold" Margin="0,0,0,8" />
                    <RadioButton x:Name="LangAutoRadio" Content="Auto" Foreground="#E0E0E0" Margin="0,2" IsChecked="True" />
                    <RadioButton x:Name="LangEnRadio" Content="English" Foreground="#E0E0E0" Margin="0,2" />
                    <RadioButton x:Name="LangHiRadio" Content="Hindi" Foreground="#E0E0E0" Margin="0,2" />
                    <TextBlock Margin="0,12,0,0" Foreground="#888888" FontSize="11" TextWrapping="Wrap"
                               Text="Reserved: the service detects the language of each answer automatically. This preference will steer UI display strings in a later version." />
                </StackPanel>
            </TabItem>            <!-- Tab 3: Voice -->
            <TabItem Header="Voice">
                <StackPanel Margin="12" Background="#232323">
                    <CheckBox x:Name="VoiceOutputCheck" Content="Enable voice output (TTS)" Foreground="#E0E0E0" Margin="0,2" />
                    <CheckBox x:Name="PushToTalkCheck" Content="Enable push-to-talk (Ctrl+Alt+Space)" Foreground="#E0E0E0" Margin="0,6,0,2" />
                    <TextBlock Text="Voice model:" Margin="0,14,0,4" />
                    <ComboBox x:Name="VoiceModelCombo" Width="240" HorizontalAlignment="Left" IsEnabled="False">
                        <ComboBoxItem Content="hi_IN-rohan-medium" />
                    </ComboBox>
                    <TextBlock Margin="0,8,0,0" Foreground="#888888" FontSize="11" TextWrapping="Wrap"
                               Text="v1 ships only hi_IN-rohan-medium; the picker is disabled until more models are bundled." />
                </StackPanel>
            </TabItem>

            <!-- Tab 4: Privacy -->
            <TabItem Header="Privacy">
                <Grid Margin="12" Background="#232323">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="Excluded window-title patterns:" FontWeight="Bold" />
                    <ListBox Grid.Row="1" x:Name="PatternList" Margin="0,6,0,6"
                             Background="#2A2A2A" Foreground="#E0E0E0" BorderBrush="#3A3A3A" />
                    <Grid Grid.Row="2" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" x:Name="PatternInput" Background="#2A2A2A" Foreground="#E0E0E0"
                                 BorderBrush="#3A3A3A" Padding="4" VerticalContentAlignment="Center" />
                        <Button Grid.Column="1" Content="Add" Padding="10,4" Margin="6,0,0,0" Click="AddPatternButton_Click" />
                        <Button Grid.Column="2" Content="Remove" Padding="10,4" Margin="6,0,0,0" Click="RemovePatternButton_Click" />
                    </Grid>
                    <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,0,0,8">
                        <Button Content="Purge cache now" Padding="10,4" Click="PurgeCacheButton_Click" />
                        <TextBlock x:Name="PurgeStatusText" Margin="8,0,0,0" VerticalAlignment="Center" Foreground="#888888" />
                    </StackPanel>
                    <CheckBox Grid.Row="4" x:Name="EncryptCacheCheck" Content="Encrypt cache (enabled by the service)"
                              IsEnabled="False" Foreground="#E0E0E0" Margin="0,0,0,8" />
                    <Grid Grid.Row="5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Audit log location: data/audit.log" VerticalAlignment="Center" Foreground="#B0B0B0" />
                        <Button Grid.Column="1" Content="Open folder" Padding="10,4" Click="OpenAuditFolderButton_Click" />
                    </Grid>
                </Grid>
            </TabItem>

            <!-- Tab 5: About -->
            <TabItem Header="About">
                <StackPanel Margin="12" Background="#232323">
                    <TextBlock FontWeight="Bold" FontSize="14" Text="TradeCopilot" />
                    <TextBlock x:Name="VersionText" Margin="0,6,0,0" Foreground="#B0B0B0" />
                    <!-- TODO(v1.1): replace with the real repository URL once published. -->
                    <TextBlock Margin="0,12,0,0" Foreground="#B0B0B0" Text="GitHub: not yet published" />
                    <TextBlock Margin="0,4,0,0" Foreground="#B0B0B0" Text="License: see repository (no LICENSE published yet)" />
                    <TextBlock Margin="0,12,0,0" Foreground="#888888" FontSize="11" TextWrapping="Wrap"
                               Text="Built on LLamaSharp, Whisper.net, ONNX Runtime, Windows OCR, NAudio, H.NotifyIcon and CommunityToolkit.Mvvm. All processing runs locally." />
                </StackPanel>
            </TabItem>
        </TabControl>

        <Grid Grid.Row="1" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" x:Name="StatusText" VerticalAlignment="Center" Foreground="#888888" FontSize="11" />
            <Button Grid.Column="1" Content="Save" Width="80" Margin="0,0,8,0" Background="#4A9EFF" Foreground="White"
                    Click="SaveButton_Click" />
            <Button Grid.Column="2" Content="Close" Width="80" Click="CloseButton_Click" />
        </Grid>
    </Grid>
</Window>
