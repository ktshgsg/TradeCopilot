<Window x:Class="TradeCopilot.UI.Views.FirstRunWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TradeCopilot Setup"
        Width="600" Height="450" MinWidth="560" MinHeight="420"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        Background="#1A1A1A" Foreground="#E0E0E0"
        FontFamily="Segoe UI">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Welcome to TradeCopilot"
                       FontSize="18" FontWeight="Bold" Foreground="#E0E0E0" />
            <TextBlock Text="One-time download of AI models (~1.5 GB). This only happens once."
                       Foreground="#9E9E9E" Margin="0,6,0,0" TextWrapping="Wrap" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Files}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="26" />
                                <ColumnDefinition Width="130" />
                                <ColumnDefinition Width="180" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0">
                                <TextBlock Text="{Binding Name}" Foreground="#E0E0E0" />
                                <TextBlock Text="{Binding TargetPath}" Foreground="#777777" FontSize="10" />
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="{Binding StatusIcon}"
                                       Foreground="{Binding StatusBrush}"
                                       FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <ProgressBar Grid.Column="2" Height="8" VerticalAlignment="Center"
                                         Minimum="0" Maximum="100" Value="{Binding Progress, Mode=OneWay}" />
                            <TextBlock Grid.Column="3" Text="{Binding DetailText}" FontSize="11"
                                       Foreground="#9E9E9E" VerticalAlignment="Center" Margin="10,0,0,0" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <StackPanel Grid.Row="2">
            <Grid Margin="0,8,0,0">
                <TextBlock Text="{Binding StatusText}" FontSize="11" Foreground="#9E9E9E"
                           VerticalAlignment="Center" />
                <TextBlock Text="{Binding EtaText}" FontSize="11" Foreground="#9E9E9E"
                           HorizontalAlignment="Right" VerticalAlignment="Center" />
            </Grid>
            <ProgressBar Height="8" Margin="0,8,0,0" Minimum="0" Maximum="100"
                         Value="{Binding OverallProgress, Mode=OneWay}" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button Content="Cancel" Width="90" Padding="10,6" Margin="0,0,10,0"
                        Command="{Binding CancelCommand}" />
                <Button Content="Skip for now" Width="110" Padding="10,6" Margin="0,0,10,0"
                        Command="{Binding SkipCommand}" />
                <Button Content="Continue" Width="110" Padding="10,6"
                        Background="#4A9EFF" Foreground="White"
                        IsEnabled="{Binding AllComplete}" Command="{Binding ContinueCommand}" />
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>