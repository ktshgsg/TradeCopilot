<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\TradeCopilot.UI.Logic\TradeCopilot.UI.Logic.csproj" />
    <!-- Push-to-talk adapts Core's AudioCapture in the UI process. -->
    <ProjectReference Include="..\TradeCopilot.Core\TradeCopilot.Core.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- GlobalHotkey uses LibraryImport source generation (generated marshalling is unsafe). -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <!-- UI framework -->
    <PackageReference Include="H.NotifyIcon.Wpf" />
    <PackageReference Include="CommunityToolkit.Mvvm" />

    <!-- Dependency injection / generic host -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- Tray icons are pack-URI resources referenced by MainWindow.xaml. -->
    <Resource Include="Assets\tray.ico" />
    <Resource Include="Assets\tray-paused.ico" />
  </ItemGroup>

</Project>
